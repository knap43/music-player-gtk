[Desktop Entry]
Type=Application
Name=Amber
GenericName=Music Player
Comment=Play local MP3, FLAC and WebM files
Exec=amber-player %F
Icon=io.github.knap43.Amber
Terminal=false
Categories=AudioVideo;Audio;Player;GTK;GNOME;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/webm;video/webm;inode/directory;
Keywords=music;audio;player;mp3;flac;webm;lyrics;
StartupNotify=true
DBusActivatable=false
